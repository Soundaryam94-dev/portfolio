# EmailJS settings for the contact form. Copy this file to .env.local (git-ignored) and fill in your own values from
# https://dashboard.emailjs.com. All three are public by design (they are sent from the browser); never put your EmailJS
# PRIVATE key here or anywhere in this project.
#
# Your EmailJS template can use: {{from_name}}, {{from_email}}, {{reply_to}}, {{subject}}, {{message}}, {{to_name}}
# Set the template's "Reply To" to {{reply_to}} so you can answer visitors directly.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
